{
  "name": "claude-speedometer",
  "displayName": "Claude Speedometer",
  "description": "Indicator showing the token throughput and timing of your Claude Code interactions.",
  "version": "1.8.0",
  "publisher": "zeyutang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeyutang/claude-speedometer.git"
  },
  "bugs": {
    "url": "https://github.com/zeyutang/claude-speedometer/issues"
  },
  "homepage": "https://github.com/zeyutang/claude-speedometer#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI"
  ],
  "keywords": [
    "claude",
    "claude code",
    "telemetry",
    "opentelemetry",
    "otel",
    "tokens",
    "tokens per second",
    "status bar",
    "throughput",
    "metrics",
    "speed"
  ],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeSpeedometer.togglePanel",
        "title": "Claude Speedometer: Show / Hide Stats Tab"
      },
      {
        "command": "claudeSpeedometer.configureTelemetry",
        "title": "Claude Speedometer: Configure Claude Code Telemetry"
      }
    ],
    "configuration": {
      "title": "Claude Speedometer",
      "properties": {
        "claudeSpeedometer.port": {
          "type": "number",
          "default": 4318,
          "description": "Localhost port the embedded OTLP/HTTP receiver listens on. Must match the OTEL_EXPORTER_OTLP_ENDPOINT configured for Claude Code."
        },
        "claudeSpeedometer.exportIntervalMs": {
          "type": "number",
          "default": 2000,
          "description": "OTEL_LOGS_EXPORT_INTERVAL written when auto-configuring Claude Code. Lower = more responsive status bar, more frequent exports."
        },
        "claudeSpeedometer.statusBarPriority": {
          "type": "number",
          "default": -1000001,
          "description": "Status bar priority within the right-hand cluster. Higher = further left, lower = further right."
        },
        "claudeSpeedometer.retentionDays": {
          "type": "number",
          "default": 7,
          "description": "Discard interactions older than this many days from the shared history file (~/.claude-speedometer/state.json)."
        },
        "claudeSpeedometer.modelPricing": {
          "type": "object",
          "default": {},
          "markdownDescription": "Rates in USD per million tokens for models Claude Code cannot price, which it otherwise costs at its own default model's rate. `byEndpoint` maps a base URL to the models served there, with `\"*\"` as that endpoint's default. `byModel` applies only when the base URL cannot be resolved. Each rate needs all four figures. An interaction with no matching rate reads as \"unpriced\" rather than as free.",
          "additionalProperties": false,
          "properties": {
            "byEndpoint": {
              "type": "object",
              "description": "Base URL, then model id, then rate.",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "input",
                    "output",
                    "cacheRead",
                    "cacheWrite"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "input": {
                      "type": "number",
                      "minimum": 0
                    },
                    "output": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cacheRead": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cacheWrite": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "byModel": {
              "type": "object",
              "description": "Model id, then rate.",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "input",
                  "output",
                  "cacheRead",
                  "cacheWrite"
                ],
                "additionalProperties": false,
                "properties": {
                  "input": {
                    "type": "number",
                    "minimum": 0
                  },
                  "output": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cacheRead": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cacheWrite": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "claudeSpeedometer.billingContextProvider": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Which extension to ask where Claude Code is sending requests. `auto` takes the first extension in this window that exports a `getBillingContext()` function and reports itself armed, `off` asks none, and any other value pins a single extension id."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
